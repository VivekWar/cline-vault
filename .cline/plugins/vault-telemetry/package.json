{
  "name": "vault-telemetry",
  "version": "0.1.0",
  "description": "Cline SDK plugin: automatic Vault activity telemetry via the afterTool hook.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "cline": {
    "plugins": [
      {
        "paths": ["./index.ts"],
        "capabilities": ["hooks"]
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test 'dist/*.test.js'"
  },
  "devDependencies": {
    "@cline/sdk": "^0.0.90",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
